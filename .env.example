# Decision Intelligence — variables d'environnement (dev)
# Copier vers .env / .env.local selon le service. Ne jamais committer de vraies clés.
# Voir docs/SPEC.md §11 (Sécurité) et §12 (Déploiement).

# ── decision-engine (FastAPI) ──
# Clé interne NestJS ↔ FastAPI — Phase 5 seulement. Vide en Phase 2 (service ouvert).
# Génération : openssl rand -hex 32
INTERNAL_API_KEY=

# Origines CORS autorisées (liste séparée par virgules). Défaut côté code : http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Port FastAPI (utilisé par docker-compose + uvicorn)
ENGINE_PORT=8000

# Taille max fichier (Mo) — doit rester cohérent avec decision-engine/main.py:MAX_FILE_SIZE_MB
MAX_FILE_SIZE_MB=50

# ── frontend (Vite / React) ──
# URL de decision-engine — doit pointer vers ENGINE_PORT en dev
VITE_API_URL=http://localhost:8000

# Port Vite dev server
VITE_PORT=5173

# ── Phase 5+ (Supabase / NestJS — non utilisé en Phase 2) ──
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=postgresql://postgres:postgres@db:5432/decision
# NESTJS_PORT=3000
# JWT_SECRET=
